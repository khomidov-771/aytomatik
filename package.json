{
  "name": "ids-automate",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["web"],
  "scripts": {
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "lint:web": "npm --workspace web run lint",
    "test:web": "npm --workspace web run test",
    "test:e2e": "npm --workspace web run test:e2e",
    "test": "npm run lint:web && npm run test:web && npm run build:web"
  }
}

