# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
PORT=8080

# Data services
DATABASE_URL=postgres://ids:ids_dev_password@localhost:5432/ids_automate?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security — generate unique values; never commit the real .env file
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12

# Product provider. The mock adapter is test-only and cannot run outside APP_ENV=test.
INSTAGRAM_PROVIDER=meta
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_LOGIN_MODE=unified
# Meta bergan public Login for Business Configuration ID; bu secret emas.
META_LOGIN_CONFIG_ID=2331645327602552
META_REDIRECT_URI=http://localhost:8080/api/v1/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=

# Frontend build-time public API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Mail: log is development-only; production requires smtp with STARTTLS
MAIL_PROVIDER=log
MAIL_FROM=IDS Automate <noreply@example.com>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true
